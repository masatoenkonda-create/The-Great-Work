      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Acrobat Distiller Command 3.0 for Solaris 2.3 and later (SPARC)</pdf:Producer>
         <pdf:Keywords>"EP1429372"; "EP 1429372"; "H01L 21/00"; "H05K 13/02"; "H05K 13/04"; "Apparatus and method for thin die detachment"</pdf:Keywords>
         <pdf:PDFVersion>1.4</pdf:PDFVersion>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/">
         <pdfaid:part>1</pdfaid:part>
         <pdfaid:conformance>B</pdfaid:conformance>
